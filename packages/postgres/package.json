{
  "name": "@airnest/postgres",
  "version": "0.0.0",
  "description": "PostgreSQL storage and task queue for airnest: runs, leases, retries, pools and logs",
  "keywords": [
    "dag",
    "airflow",
    "postgresql",
    "queue",
    "skip-locked"
  ],
  "author": "Tarcisio Ferreira",
  "license": "MIT",
  "homepage": "https://tqrcisio.github.io/airnest-docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tqrcisio/airnest.git",
    "directory": "packages/postgres"
  },
  "bugs": {
    "url": "https://github.com/tqrcisio/airnest/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@airnest/core": "workspace:*"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/pg": "8.23.1",
    "pg": "8.23.1"
  }
}
