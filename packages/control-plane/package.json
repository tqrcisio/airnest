{
  "name": "@airnest/control-plane",
  "version": "0.1.0",
  "description": "HTTP API and admin UI for airnest DAGs, served by a NestJS module",
  "keywords": [
    "nestjs",
    "dag",
    "airflow",
    "admin",
    "dashboard"
  ],
  "author": "Tarcisio Ferreira",
  "license": "MIT",
  "homepage": "https://tqrcisio.github.io/airnest-docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tqrcisio/airnest.git",
    "directory": "packages/control-plane"
  },
  "bugs": {
    "url": "https://github.com/tqrcisio/airnest/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "admin"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rm -rf dist admin && tsc -p tsconfig.build.json && cp -r ../../apps/admin/dist admin",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@airnest/core": "workspace:*",
    "@airnest/postgres": "workspace:*",
    "@airnest/manifest": "workspace:*"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0 || ^12.0.0",
    "@nestjs/core": "^11.0.0 || ^12.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/testing": "12.1.2",
    "@types/supertest": "7.2.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "supertest": "7.3.1"
  }
}
