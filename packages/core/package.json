{
  "name": "@airnest/core",
  "version": "0.0.1",
  "description": "DAG definitions, scheduling and state rules for airnest",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
