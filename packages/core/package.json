{
  "name": "@airnest/core",
  "version": "0.1.0",
  "description": "Airflow-style DAG engine: graph validation, trigger rules, run planning, retries and cron timetables",
  "keywords": [
    "dag",
    "airflow",
    "scheduler",
    "workflow",
    "cron"
  ],
  "author": "Tarcisio Ferreira",
  "license": "MIT",
  "homepage": "https://tqrcisio.github.io/airnest-docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tqrcisio/airnest.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/tqrcisio/airnest/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "croner": "10.0.1",
    "ajv": "8.17.1"
  }
}
