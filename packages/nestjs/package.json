{
  "name": "@airnest/nestjs",
  "version": "0.1.0",
  "description": "Airflow-style DAGs for NestJS: declare DAGs with @Dag and @Task, scheduled and run by your app",
  "keywords": [
    "nestjs",
    "nest",
    "dag",
    "airflow",
    "scheduler",
    "workflow",
    "etl"
  ],
  "author": "Tarcisio Ferreira",
  "license": "MIT",
  "homepage": "https://tqrcisio.github.io/airnest-docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tqrcisio/airnest.git",
    "directory": "packages/nestjs"
  },
  "bugs": {
    "url": "https://github.com/tqrcisio/airnest/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@airnest/core": "workspace:*",
    "@airnest/postgres": "workspace:*"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0 || ^12.0.0",
    "@nestjs/core": "^11.0.0 || ^12.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.1.0"
  },
  "devDependencies": {
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/testing": "12.1.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "@electric-sql/pglite": "0.5.8"
  }
}
